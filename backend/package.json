{
  "type": "module",
  "name": "backend",
  "description": "This project was bootstrapped with Fastify-CLI.",
  "version": "1.2.0",
  "main": "app.ts",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "tsc -p test/tsconfig.json && FASTIFY_AUTOLOAD_TYPESCRIPT=1 node --import tsx --test 'test/**/*.test.ts'",
    "start": "fastify start -l info dist/app.js",
    "build:ts": "tsc && tsc-alias",
    "watch:ts": "tsc -w",
    "watch:alias": "tsc-alias -w",
    "dev": "npm run build:ts && concurrently -k -p \"[{name}]\" -n \"TypeScript,App\" -c \"yellow.bold,cyan.bold\" \"npm:watch:ts\" \"npm:watch:alias\" \"npm:dev:start\"",
    "dev:start": "fastify start --ignore-watch=.ts$ -w -l info -P dist/app.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=22.22.0"
  },
  "dependencies": {
    "@fastify/autoload": "^5.0.0",
    "@fastify/env": "^4.4.0",
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^4.0.0",
    "fastify": "^4.26.1",
    "fastify-cli": "^6.1.1",
    "fastify-plugin": "^4.0.0",
    "fastify-type-provider-zod": "^2.0.0",
    "handlebars": "^4.7.9",
    "html-validate": "^11",
    "nats": "^2.29.3",
    "puppeteer": "^25",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22",
    "concurrently": "^8.2.2",
    "fastify-tsconfig": "^2.0.0",
    "tsc-alias": "1.8.10",
    "tsx": "^4.23.1",
    "typescript": "^5.2.2"
  },
  "resolutions": {
    "string-width": "4.2.3",
    "strip-ansi": "6.0.0",
    "wrap-ansi": "7.0.0"
  }
}
