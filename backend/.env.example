PORT=3001
# NATS connection string. Credentials, TLS and clustering all go in this one
# URL -- see "Connecting to a protected NATS" in the README.
#   nats://user:pass@localhost:4222        user/password
#   nats://sometoken@localhost:4222        token
#   tls://user:pass@localhost:4222         user/password over TLS
#   nats://user:pass@h1:4222,h2:4222       cluster
# Special characters in the password must be percent-encoded (p@ss -> p%40ss).
QUEUE_URL=
QUEUE_SUBJECT=generate.pdf
QUEUE_SUBSCRIBE=generate.>
