{
  "extends": "fastify-tsconfig",
  "compilerOptions": {
    "outDir": "dist",
    "sourceMap": true,
    "moduleResolution": "Bundler",
    "module": "ES2022",
    "target": "ES2022",
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@src/*": ["src/*"]
    },
    // "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    // "types": [
    //   "./src/app.d.ts"
    // ]
  },
  "tsc-alias": {
    "resolveFullPaths": true,
    "verbose": true
  },
  "include": ["src/**/*.ts"]
}
