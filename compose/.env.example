PORT=3001
# The webhook url that will be called when a pdf is generated, the url should use POST method.
# The alias will be sent in the query string with the name "alias" if provided.
# Please refer to client app for complete example.
# Example: WEBHOOK_URL=http://localhost:3002
WEBHOOK_URL=
# NATS connection string. Credentials, TLS and clustering all go in this one
# URL -- see "Connecting to a protected NATS" in the README.
#   nats://user:pass@nats:4222        user/password
#   nats://sometoken@nats:4222        token
#   tls://user:pass@nats:4222         user/password over TLS
#   nats://user:pass@h1:4222,h2:4222  cluster
# Special characters in the password must be percent-encoded (p@ss -> p%40ss).
QUEUE_URL=nats://nats:4222
# Subject the service publishes generate-pdf jobs to.
QUEUE_SUBJECT=generate.pdf
# Subject pattern the worker subscribes to.
QUEUE_SUBSCRIBE=generate.>
